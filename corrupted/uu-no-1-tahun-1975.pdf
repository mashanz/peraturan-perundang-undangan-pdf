<script>jQuery(function ($) {

    function updateServerTime() {
        var serverTime = new Date();
        var options = {
            year: 'numeric',
            month: 'long',
            day: 'numeric',
            hour: 'numeric',
            minute: 'numeric',
            second: 'numeric',
            timeZone: 'Asia/Jakarta'
