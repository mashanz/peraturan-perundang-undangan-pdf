{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "KEMENKEU Regulation Metadata Template",
  "description": "Standardized metadata extraction template for Indonesian Ministry of Finance regulations",
  "type": "object",
  "required": [
    "regulation_number",
    "title", 
    "regulation_type",
    "issuing_directorate",
    "issue_date",
    "status"
  ],
  "properties": {
    "regulation_number": {
      "type": "string",
      "pattern": "^[A-Z]+-[0-9]+/[A-Z0-9.]+/[0-9]{4}$",
      "description": "Official regulation number (e.g., PMK-123/PMK.03/2024)",
      "examples": ["PMK-123/PMK.03/2024", "SE-456/PJ/2024", "PER-789/PB/2024"]
    },
    "title": {
      "type": "string",
      "minLength": 10,
      "maxLength": 500,
      "description": "Official Indonesian title of the regulation"
    },
    "title_en": {
      "type": "string",
      "description": "English translation of the regulation title"
    },
    "regulation_type": {
      "type": "string",
      "enum": ["PMK", "SE", "PER", "KMK", "KEP", "PERDIRJEN"],
      "description": "Type of regulation"
    },
    "issuing_directorate": {
      "type": "string",
      "enum": [
        "Direktorat Jenderal Pajak",
        "Direktorat Jenderal Bea dan Cukai", 
        "Direktorat Jenderal Anggaran",
        "Direktorat Jenderal Perbendaharaan",
        "Direktorat Jenderal Pengelolaan Utang",
        "Direktorat Jenderal Kekayaan Negara",
        "Badan Kebijakan Fiskal",
        "Inspektorat Jenderal",
        "Sekretariat Jenderal"
      ],
      "description": "Ministry directorate that issued the regulation"
    },
    "issue_date": {
      "type": "string",
      "format": "date",
      "description": "Date the regulation was issued (YYYY-MM-DD)"
    },
    "effective_date": {
      "type": "string", 
      "format": "date",
      "description": "Date the regulation becomes effective"
    },
    "expiry_date": {
      "type": "string",
      "format": "date", 
      "description": "Date the regulation expires (if applicable)"
    },
    "status": {
      "type": "string",
      "enum": ["active", "superseded", "revoked", "draft"],
      "default": "active",
      "description": "Current status of the regulation"
    },
    "classification_level": {
      "type": "string",
      "enum": ["public", "restricted", "confidential"],
      "default": "public",
      "description": "Security classification level"
    },
    "language": {
      "type": "string",
      "enum": ["id", "en", "both"],
      "default": "id",
      "description": "Language(s) of the regulation content"
    },
    "page_count": {
      "type": "integer",
      "minimum": 1,
      "description": "Number of pages in the original document"
    },
    "article_count": {
      "type": "integer",
      "minimum": 1,
      "description": "Number of articles in the regulation"
    },
    "complexity_score": {
      "type": "number",
      "minimum": 0,
      "maximum": 10,
      "description": "Complexity assessment score (0-10)"
    },
    "readability_score": {
      "type": "number",
      "description": "Text readability score"
    },
    "international_alignment": {
      "type": "object",
      "properties": {
        "oecd_compliant": {
          "type": "boolean",
          "description": "Complies with OECD standards"
        },
        "standards": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": ["BEPS", "AEOI", "FATCA", "CRS", "OECD_MTC", "UN_MTC", "WTO", "ASEAN"]
          },
          "description": "International standards aligned with"
        },
        "treaties": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Relevant international treaties"
        }
      }
    },
    "policy_areas": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["code", "is_primary"],
        "properties": {
          "code": {
            "type": "string",
            "enum": [
              "TAX", "TAX_INCOME", "TAX_VAT", "TAX_PROPERTY", "TAX_INTERNATIONAL",
              "BUDGET", "BUDGET_PLAN", "BUDGET_EXEC", "BUDGET_CONTROL",
              "DEBT", "CUSTOMS", "CUSTOMS_TARIFF", "CUSTOMS_PROCEDURE", 
              "TREASURY", "FINANCE", "PROCUREMENT", "ACCOUNTING"
            ]
          },
          "is_primary": {
            "type": "boolean",
            "description": "Whether this is the primary policy area"
          },
          "confidence_score": {
            "type": "number",
            "minimum": 0,
            "maximum": 1,
            "description": "AI classification confidence"
          }
        }
      },
      "description": "Policy area classifications"
    },
    "themes": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["code"],
        "properties": {
          "code": {
            "type": "string",
            "enum": [
              "TRANSPARENCY", "EFFICIENCY", "COMPLIANCE", "DIGITALIZATION",
              "INTERNATIONAL", "MSME", "PANDEMIC", "REFORM", "INVESTMENT", "ENVIRONMENT"
            ]
          },
          "relevance_score": {
            "type": "number",
            "minimum": 0,
            "maximum": 1,
            "description": "Relevance score for this theme"
          }
        }
      },
      "description": "Thematic classifications"
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Detailed classification tags"
    },
    "keywords": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["keyword", "importance"],
        "properties": {
          "keyword": {
            "type": "string",
            "description": "Extracted keyword"
          },
          "importance": {
            "type": "number",
            "minimum": 0,
            "maximum": 1,
            "description": "Keyword importance score"
          },
          "frequency": {
            "type": "integer",
            "minimum": 1,
            "description": "Frequency in document"
          }
        }
      },
      "description": "Extracted keywords with importance scores"
    },
    "content": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["content_type", "sequence_number", "content"],
        "properties": {
          "content_type": {
            "type": "string",
            "enum": ["chapter", "article", "section", "appendix", "annex"]
          },
          "sequence_number": {
            "type": "integer",
            "minimum": 1
          },
          "title": {
            "type": "string",
            "description": "Section title"
          },
          "content": {
            "type": "string",
            "description": "Section content text"
          },
          "content_en": {
            "type": "string",
            "description": "English translation"
          },
          "depth_level": {
            "type": "integer",
            "minimum": 1,
            "maximum": 5,
            "default": 1,
            "description": "Hierarchical depth level"
          },
          "word_count": {
            "type": "integer",
            "minimum": 0
          },
          "has_tables": {
            "type": "boolean",
            "default": false
          },
          "has_formulas": {
            "type": "boolean", 
            "default": false
          },
          "has_references": {
            "type": "boolean",
            "default": false
          }
        }
      },
      "description": "Structured regulation content"
    },
    "relationships": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["type", "target_regulation_number"],
        "properties": {
          "type": {
            "type": "string",
            "enum": ["amends", "supersedes", "references", "implements", "cites", "relates_to"]
          },
          "target_regulation_number": {
            "type": "string",
            "description": "Regulation number being referenced"
          },
          "description": {
            "type": "string",
            "description": "Description of the relationship"
          },
          "article_reference": {
            "type": "string",
            "description": "Specific article or section reference"
          }
        }
      },
      "description": "Relationships to other regulations"
    },
    "source_metadata": {
      "type": "object",
      "properties": {
        "source_file_path": {
          "type": "string",
          "description": "Path to original document file"
        },
        "source_file_hash": {
          "type": "string",
          "pattern": "^[a-fA-F0-9]{64}$",
          "description": "SHA-256 hash of source file"
        },
        "pdf_url": {
          "type": "string",
          "format": "uri",
          "description": "URL to PDF document"
        },
        "extraction_method": {
          "type": "string",
          "enum": ["ocr", "text_extraction", "manual_entry", "api_import"],
          "description": "Method used for content extraction"
        },
        "extraction_timestamp": {
          "type": "string",
          "format": "date-time",
          "description": "When the content was extracted"
        }
      }
    },
    "quality_metrics": {
      "type": "object",
      "properties": {
        "conversion_quality_score": {
          "type": "number",
          "minimum": 0,
          "maximum": 10,
          "description": "Overall conversion quality score"
        },
        "content_accuracy": {
          "type": "number",
          "minimum": 0,
          "maximum": 10,
          "description": "Content accuracy assessment"
        },
        "metadata_completeness": {
          "type": "number",
          "minimum": 0,
          "maximum": 1,
          "description": "Metadata completeness ratio"
        },
        "validation_errors": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "field": { "type": "string" },
              "error": { "type": "string" },
              "severity": { 
                "type": "string", 
                "enum": ["critical", "major", "minor", "warning"] 
              }
            }
          }
        }
      }
    }
  },
  "examples": [
    {
      "regulation_number": "PMK-123/PMK.03/2024",
      "title": "Peraturan Menteri Keuangan tentang Pajak Penghasilan Wajib Pajak Dalam Negeri",
      "title_en": "Minister of Finance Regulation on Income Tax for Domestic Taxpayers",
      "regulation_type": "PMK",
      "issuing_directorate": "Direktorat Jenderal Pajak",
      "issue_date": "2024-01-15",
      "effective_date": "2024-02-01",
      "status": "active",
      "page_count": 45,
      "article_count": 28,
      "complexity_score": 7.5,
      "policy_areas": [
        {
          "code": "TAX_INCOME",
          "is_primary": true,
          "confidence_score": 0.95
        }
      ],
      "themes": [
        {
          "code": "COMPLIANCE",
          "relevance_score": 0.85
        },
        {
          "code": "EFFICIENCY",
          "relevance_score": 0.72
        }
      ],
      "tags": ["corporate_tax", "individual_tax", "withholding_tax"],
      "international_alignment": {
        "oecd_compliant": true,
        "standards": ["BEPS", "AEOI"]
      },
      "content": [
        {
          "content_type": "chapter",
          "sequence_number": 1,
          "title": "KETENTUAN UMUM",
          "content": "Dalam Peraturan Menteri ini yang dimaksud dengan...",
          "depth_level": 1,
          "word_count": 245,
          "has_tables": false,
          "has_formulas": true
        }
      ]
    }
  ]
}