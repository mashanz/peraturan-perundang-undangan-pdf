{
  "index_name": "kemenkeu_regulations",
  "settings": {
    "number_of_shards": 3,
    "number_of_replicas": 1,
    "max_result_window": 50000,
    "analysis": {
      "analyzer": {
        "indonesian_analyzer": {
          "type": "custom",
          "tokenizer": "standard",
          "filter": [
            "lowercase",
            "indonesian_stop_filter",
            "indonesian_stemmer",
            "unique"
          ]
        },
        "english_analyzer": {
          "type": "custom",
          "tokenizer": "standard",
          "filter": [
            "lowercase",
            "english_stop_filter",
            "english_stemmer",
            "unique"
          ]
        },
        "regulation_number_analyzer": {
          "type": "custom",
          "tokenizer": "keyword",
          "filter": [
            "uppercase",
            "trim"
          ]
        },
        "ngram_analyzer": {
          "type": "custom",
          "tokenizer": "standard",
          "filter": [
            "lowercase",
            "ngram_filter"
          ]
        }
      },
      "filter": {
        "indonesian_stop_filter": {
          "type": "stop",
          "stopwords": [
            "yang", "dan", "di", "ke", "dari", "untuk", "pada", "dengan", "dalam", "oleh",
            "adalah", "akan", "dapat", "telah", "atau", "juga", "tidak", "ini", "itu", "nya",
            "sebagai", "antara", "melalui", "karena", "sehingga", "bahwa", "seperti", "atas",
            "bagi", "terhadap", "tentang", "mengenai", "sesuai", "berdasarkan", "menurut"
          ]
        },
        "english_stop_filter": {
          "type": "stop",
          "stopwords": "_english_"
        },
        "indonesian_stemmer": {
          "type": "stemmer",
          "language": "indonesian"
        },
        "english_stemmer": {
          "type": "stemmer",
          "language": "english"
        },
        "ngram_filter": {
          "type": "ngram",
          "min_gram": 3,
          "max_gram": 20
        }
      }
    }
  },
  "mappings": {
